# VoiceKirana configuration

# Backend URL used by the frontend
BACKEND_URL=http://localhost:8001

# Application name
APP_NAME=VoiceKirana

# Gnani AI credential identifier — set your own value in .env
GNANI_API_KEY_ID=your-gnani-api-key-id-here

# VoiceKirana backend authentication token — set your own value in .env
VOICEKIRANA_API_TOKEN=your-voicekirana-token-here

# Database connection (leave blank to use local SQLite)
DATABASE_URL=
JWT_SECRET_KEY=PASTE_GENERATED_JWT_SECRET_HERE
VOICEKIRANA_ADMIN_TOKEN=PASTE_GENERATED_ADMIN_TOKEN_HERE
